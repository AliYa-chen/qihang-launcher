; Qihang vehicle scene. Native Android host owns the application lifecycle.
config_version=5

[application]
config/name="Qihang Vehicle Scene"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.0863, 0.0902, 0.0941, 1)
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/quit_on_go_back=false

[display]
window/size/viewport_width=960
window/size/viewport_height=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.0863, 0.0902, 0.0941, 1)

[physics]
common/enable_pause_aware_picking=true
